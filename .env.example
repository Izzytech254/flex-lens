# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Your public domain, e.g. https://fixlens.app
# Used for canonical URLs, Open Graph, sitemap.xml, robots.txt and llms.txt.
# Set it at BUILD time as well as runtime so the page metadata uses the right domain.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# GEMINI_MODELS (optional): comma-separated model fallback order.
# GEMINI_MODELS="gemini-3.5-flash,gemini-3.5-flash-lite"

# Natural voice via Google Cloud Text-to-Speech (tried first). Enable "Cloud Text-to-Speech API" in your
# Google Cloud project. Uses GOOGLE_TTS_API_KEY, or GEMINI_API_KEY if that key's project has the API enabled.
# GOOGLE_TTS_API_KEY="MY_GOOGLE_CLOUD_API_KEY"
# GOOGLE_TTS_VOICE="en-US-Chirp3-HD-Charon"   # e.g. en-US-Chirp3-HD-Aoede for a female voice

# Alternative natural voice: ElevenLabs (used if Google Cloud TTS fails). Get a key at https://elevenlabs.io → Profile → API keys.
# ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"
# Optional: ELEVENLABS_VOICE_ID (default: George, a calm narration voice), ELEVENLABS_MODEL (default: eleven_flash_v2_5)

# Fallback natural voice (Gemini text-to-speech). Optional overrides:
# GEMINI_TTS_VOICE="Kore"
# GEMINI_TTS_MODELS="gemini-3.5-flash-tts,gemini-2.5-flash-preview-tts"
